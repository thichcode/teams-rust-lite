import { Button } from "std-widgets.slint";

export component LoginView inherits Rectangle {
    in property <string> status-text: "Sign in with your Microsoft account to get started.";
    in property <bool> is-loading: false;
    in property <string> user-code: "";
    in property <string> verification-url: "https://microsoft.com/devicelogin";
    
    in property <string> app-version: "v0.1.0";
    in property <bool> is-dark-theme: false;
    in property <string> theme-mode-icon: "🔄";
    in property <bool> is-update-available: false;
    in property <string> update-info-text: "";

    callback start-login-work();
    callback start-login-personal();
    callback open-browser-login();
    callback toggle-theme();
    callback check-update();
    callback open-update();
    callback install-update();
    callback open-logs();

    background: root.is-dark-theme ? #1f1f1f : #f5f5f7;

    VerticalLayout {
        // Top Toolbar on Home/Login page
        Rectangle {
            height: 48px;
            background: transparent;

            HorizontalLayout {
                padding-left: 20px;
                padding-right: 20px;
                spacing: 12px;
                alignment: end;

                // Version label
                HorizontalLayout {
                    alignment: center;
                    Text {
                        text: root.app-version;
                        font-size: 11px;
                        color: root.is-dark-theme ? #888888 : #999999;
                        vertical-alignment: center;
                    }
                }

                // Theme Mode Switcher
                touch-theme := TouchArea {
                    width: 32px;
                    height: 32px;
                    clicked => { root.toggle-theme(); }
                    Rectangle {
                        border-radius: 6px;
                        background: touch-theme.has-hover ? (root.is-dark-theme ? #333338 : #e8e8ed) : transparent;
                        Text {
                            text: root.theme-mode-icon;
                            font-size: 16px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                // Update Checker Button
                touch-update := TouchArea {
                    height: 32px;
                    clicked => { root.check-update(); }
                    Rectangle {
                        border-radius: 6px;
                        background: touch-update.has-hover ? (root.is-dark-theme ? #333338 : #e8e8ed) : (root.is-dark-theme ? #28282c : #ebebee);
                        border-width: 1px;
                        border-color: root.is-update-available ? #ffd700 : (root.is-dark-theme ? #3e3e42 : #d0d0d5);

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 6px;
                            alignment: center;

                            Text {
                                text: root.is-update-available ? "⚡" : "⇪";
                                color: root.is-update-available ? #ffd700 : (root.is-dark-theme ? #ffffff : #333333);
                                font-size: 14px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }

                            Text {
                                text: root.is-update-available ? "Có bản mới!" : "Kiểm tra cập nhật";
                                color: root.is-update-available ? (root.is-dark-theme ? #ffd700 : #b8860b) : (root.is-dark-theme ? #cccccc : #444444);
                                font-size: 12px;
                                font-weight: root.is-update-available ? 700 : 500;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // Log Viewer Button
                touch-logs := TouchArea {
                    height: 32px;
                    clicked => { root.open-logs(); }
                    Rectangle {
                        border-radius: 6px;
                        background: touch-logs.has-hover ? (root.is-dark-theme ? #333338 : #e8e8ed) : (root.is-dark-theme ? #28282c : #ebebee);
                        border-width: 1px;
                        border-color: root.is-dark-theme ? #3e3e42 : #d0d0d5;

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 6px;
                            alignment: center;

                            Text {
                                text: "📄";
                                font-size: 13px;
                                vertical-alignment: center;
                            }

                            Text {
                                text: "Xem Log";
                                color: root.is-dark-theme ? #cccccc : #444444;
                                font-size: 12px;
                                font-weight: 500;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }

        // Update Notification Banner (if update available)
        if root.is-update-available: HorizontalLayout {
            alignment: center;
            padding-bottom: 12px;

            Rectangle {
                width: 520px;
                height: 42px;
                border-radius: 8px;
                background: root.is-dark-theme ? #382d00 : #fffbe6;
                border-width: 1px;
                border-color: root.is-dark-theme ? #665000 : #ffe58f;

                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    spacing: 10px;
                    alignment: center;

                    Text {
                        text: root.update-info-text;
                        color: root.is-dark-theme ? #ffd666 : #ad6800;
                        font-size: 12px;
                        font-weight: 600;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }

                    Button {
                        text: "⚡ Cập nhật ngay";
                        primary: true;
                        clicked => { root.install-update(); }
                    }

                    Button {
                        text: "Chi tiết";
                        clicked => { root.open-update(); }
                    }
                }
            }
        }

        // Main Center Area (Logo, Titles, and Card)
        VerticalLayout {
            alignment: center;
            spacing: 24px;
            vertical-stretch: 1;

            // Logo & Title Section (All Centered Horizontally)
            VerticalLayout {
                spacing: 10px;

                // App Icon Logo
                HorizontalLayout {
                    alignment: center;
                    Image {
                        source: @image-url("../assets/icon.png");
                        width: 72px;
                        height: 72px;
                    }
                }

                Text {
                    text: "Microsoft Teams Lite";
                    font-size: 26px;
                    font-weight: 700;
                    color: root.is-dark-theme ? #f5f5f5 : #242424;
                    horizontal-alignment: center;
                }

                Text {
                    text: "Native Windows Client (Slint + Rust)";
                    font-size: 13px;
                    color: root.is-dark-theme ? #a0a0a0 : #616161;
                    horizontal-alignment: center;
                }
            }

            // Info & Login Card (Centered Horizontally)
            HorizontalLayout {
                alignment: center;

                Rectangle {
                    width: 420px;
                    border-radius: 14px;
                    background: root.is-dark-theme ? #29292d : #ffffff;
                    border-width: 1px;
                    border-color: root.is-dark-theme ? #38383f : #e5e5e8;

                    VerticalLayout {
                        padding: 24px;
                        spacing: 16px;

                        if root.user-code == "": VerticalLayout {
                            spacing: 16px;

                            touch-status-login := TouchArea {
                                clicked => { root.open-logs(); }
                                Text {
                                    text: root.status-text;
                                    font-size: 13px;
                                    color: touch-status-login.has-hover ? (root.is-dark-theme ? #60cdff : #0067b8) : (root.is-dark-theme ? #cccccc : #424242);
                                    horizontal-alignment: center;
                                    wrap: word-wrap;
                                }
                            }

                            VerticalLayout {
                                spacing: 12px;

                                // Work / School Account Button
                                touch-work := TouchArea {
                                    height: 42px;
                                    enabled: !root.is-loading;
                                    mouse-cursor: root.is-loading ? default : pointer;
                                    clicked => { root.start-login-work(); }

                                    Rectangle {
                                        border-radius: 8px;
                                        background: root.is-loading ? #7bb1dd : (touch-work.has-hover ? #0060aa : #0078d4);

                                        HorizontalLayout {
                                            alignment: center;
                                            spacing: 8px;

                                            Text {
                                                text: "🏢";
                                                font-size: 15px;
                                                vertical-alignment: center;
                                            }

                                            Text {
                                                text: root.is-loading ? "Đang yêu cầu đăng nhập..." : "Đăng nhập Tài khoản Công ty / Doanh nghiệp";
                                                color: #ffffff;
                                                font-size: 13px;
                                                font-weight: 600;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }

                                // Personal / Teams Free Account Button
                                touch-personal := TouchArea {
                                    height: 42px;
                                    enabled: !root.is-loading;
                                    mouse-cursor: root.is-loading ? default : pointer;
                                    clicked => { root.start-login-personal(); }

                                    Rectangle {
                                        border-radius: 8px;
                                        background: touch-personal.has-hover ? (root.is-dark-theme ? #3b3b42 : #edf4fb) : (root.is-dark-theme ? #2d2d32 : #ffffff);
                                        border-width: 1.5px;
                                        border-color: root.is-dark-theme ? #5a5a64 : #0078d4;

                                        HorizontalLayout {
                                            alignment: center;
                                            spacing: 8px;

                                            Text {
                                                text: "👤";
                                                font-size: 15px;
                                                vertical-alignment: center;
                                            }

                                            Text {
                                                text: root.is-loading ? "Đang yêu cầu đăng nhập..." : "Đăng nhập Tài khoản Cá nhân / Teams Free";
                                                color: root.is-dark-theme ? #ffffff : #0078d4;
                                                font-size: 13px;
                                                font-weight: 600;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }

                                Text {
                                    text: "🏢 Công ty: Microsoft 365, M365  •  👤 Cá nhân: Gmail, Outlook, số điện thoại";
                                    font-size: 11px;
                                    color: root.is-dark-theme ? #999999 : #666666;
                                    horizontal-alignment: center;
                                    wrap: word-wrap;
                                }
                            }
                        }

                        if root.user-code != "": VerticalLayout {
                            spacing: 14px;
                            alignment: center;

                            Text {
                                text: "Truy cập liên kết bên dưới và nhập mã xác thực:";
                                font-size: 13px;
                                color: root.is-dark-theme ? #cccccc : #555555;
                                horizontal-alignment: center;
                            }

                            Text {
                                text: root.verification-url;
                                font-size: 13px;
                                font-weight: 700;
                                color: root.is-dark-theme ? #60cdff : #0078d4;
                                horizontal-alignment: center;
                            }

                            // Prominent Code Box
                            Rectangle {
                                height: 52px;
                                border-radius: 8px;
                                background: root.is-dark-theme ? #3b3d68 : #f0f1ff;
                                border-width: 2px;
                                border-color: root.is-dark-theme ? #6264a7 : #5b5fc7;

                                Text {
                                    text: root.user-code;
                                    font-size: 24px;
                                    font-weight: 800;
                                    color: root.is-dark-theme ? #ffffff : #5b5fc7;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }

                            Text {
                                text: "✅ Mã đã tự động sao chép vào bộ nhớ tạm (Ctrl+V để dán)";
                                font-size: 11px;
                                color: root.is-dark-theme ? #69f0ae : #2e7d32;
                                horizontal-alignment: center;
                            }

                            Text {
                                text: root.status-text;
                                font-size: 12px;
                                color: root.is-dark-theme ? #a0a0a0 : #666666;
                                horizontal-alignment: center;
                                wrap: word-wrap;
                            }

                            HorizontalLayout {
                                spacing: 10px;
                                alignment: center;

                                Button {
                                    text: "🌐 Mở lại trang web";
                                    clicked => { root.open-browser-login(); }
                                }

                                Button {
                                    text: "🔄 Đổi mã mới";
                                    clicked => { root.start-login-personal(); }
                                }
                            }
                        }
                    }
                }
            }

            // Footer note
            Text {
                text: "Ultra-fast (<0.4s startup), low memory (<60MB RAM), native toast notifications";
                font-size: 11px;
                color: root.is-dark-theme ? #777777 : #8a8a8a;
                horizontal-alignment: center;
            }
        }
    }
}
