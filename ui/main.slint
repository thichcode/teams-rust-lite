import { Button, LineEdit, ScrollView } from "std-widgets.slint";
import { ChatItem } from "components/chat_item.slint";
import { MessageBubble } from "components/message.slint";
import { LoginView } from "login.slint";

export struct ConversationData {
    id: string,
    title: string,
    last_message: string,
    timestamp: string,
    unread_count: int,
    avatar_text: string,
}

export struct MessageData {
    id: string,
    sender_name: string,
    content: string,
    timestamp: string,
    is_self: bool,
}

export component MainWindow inherits Window {
    title: "Microsoft Teams Lite";
    icon: @image-url("../assets/icon.png");
    default-font-family: "Segoe UI";
    preferred-width: 980px;
    preferred-height: 680px;
    min-width: 720px;
    min-height: 500px;
    background: is-dark-theme ? #1f1f1f : #ffffff;

    in property <bool> is-logged-in: false;
    in property <string> login-status: "Ready to sign in";
    in property <bool> is-authenticating: false;
    in property <string> login-user-code: "";
    in property <string> login-verification-url: "https://www.microsoft.com/link";

    in property <string> user-name: "Teams User";
    in property <string> connection-status: "Connecting...";
    in property <bool> is-connected: true;

    in property <[ConversationData]> conversations: [];
    in property <string> active-conversation-id: "";
    in property <string> active-conversation-title: "Select a conversation";

    in property <[MessageData]> messages: [];
    in-out property <string> draft-text: "";

    in property <string> app-version: "v0.1.0";
    in property <bool> is-update-available: false;
    in property <string> update-info-text: "";

    in-out property <bool> is-dark-theme: false;
    in-out property <string> theme-mode-icon: "🔄";
    in-out property <string> theme-status-text: "Auto (Solar)";

    callback start-login-work();
    callback start-login-personal();
    callback open-browser-login();
    callback logout();
    callback select-conversation(string);
    callback send-message(string);
    callback trigger-refresh();
    callback check-for-updates();
    callback open-update-url();
    callback install-update();
    callback toggle-theme-mode();
    callback open-logs();

    if !is-logged-in: LoginView {
        status-text: root.login-status;
        is-loading: root.is-authenticating;
        user-code: root.login-user-code;
        verification-url: root.login-verification-url;
        app-version: root.app-version;
        is-dark-theme: root.is-dark-theme;
        theme-mode-icon: root.theme-mode-icon;
        is-update-available: root.is-update-available;
        update-info-text: root.update-info-text;
        start-login-work => { root.start-login-work(); }
        start-login-personal => { root.start-login-personal(); }
        open-browser-login => { root.open-browser-login(); }
        toggle-theme => { root.toggle-theme-mode(); }
        check-update => { root.check-for-updates(); }
        open-update => { root.open-update-url(); }
        install-update => { root.install-update(); }
        open-logs => { root.open-logs(); }
    }

    if is-logged-in: HorizontalLayout {
        // Left Sidebar: Conversations
        Rectangle {
            width: 320px;
            background: root.is-dark-theme ? #252528 : #f7f7f9;
            border-width: 1px;
            border-color: root.is-dark-theme ? #333338 : #e5e5ea;

            VerticalLayout {
                // Header / Profile Bar
                Rectangle {
                    height: 56px;
                    background: root.is-dark-theme ? #444791 : #5b5fc7;

                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        spacing: 10px;
                        alignment: center;

                        Rectangle {
                            width: 32px;
                            height: 32px;
                            border-radius: 16px;
                            background: #ffffff;

                            Text {
                                text: "T";
                                color: #5b5fc7;
                                font-weight: 800;
                                font-size: 16px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            spacing: 1px;
                            horizontal-stretch: 1;

                            Text {
                                text: root.user-name;
                                color: #ffffff;
                                font-size: 13px;
                                font-weight: 700;
                                overflow: elide;
                            }

                            Text {
                                text: root.connection-status;
                                color: root.is-connected ? #c8ffc8 : #ffd0d0;
                                font-size: 10px;
                                overflow: elide;
                            }
                        }

                        // Theme Mode Switcher
                        touch-main-theme := TouchArea {
                            width: 28px;
                            height: 28px;
                            clicked => { root.toggle-theme-mode(); }
                            Rectangle {
                                border-radius: 4px;
                                background: touch-main-theme.has-hover ? (root.is-dark-theme ? #5558a0 : #4d51ab) : transparent;
                                Text {
                                    text: root.theme-mode-icon;
                                    font-size: 16px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        // Refresh button
                        touch-main-refresh := TouchArea {
                            width: 28px;
                            height: 28px;
                            clicked => { root.trigger-refresh(); }
                            Rectangle {
                                border-radius: 4px;
                                background: touch-main-refresh.has-hover ? (root.is-dark-theme ? #5558a0 : #4d51ab) : transparent;
                                Text {
                                    text: "🔄";
                                    font-size: 14px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        // Update Check button
                        touch-main-update := TouchArea {
                            height: 28px;
                            clicked => { root.check-for-updates(); }
                            Rectangle {
                                border-radius: 4px;
                                background: touch-main-update.has-hover ? (root.is-dark-theme ? #5558a0 : #4d51ab) : (root.is-update-available ? #7d6608 : transparent);
                                HorizontalLayout {
                                    padding-left: 6px;
                                    padding-right: 6px;
                                    spacing: 4px;
                                    alignment: center;

                                    Text {
                                        text: "⚡";
                                        font-size: 14px;
                                        vertical-alignment: center;
                                    }

                                    if root.is-update-available: Text {
                                        text: "Update";
                                        color: #ffd700;
                                        font-size: 11px;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        // Open Logs button
                        touch-main-log := TouchArea {
                            width: 28px;
                            height: 28px;
                            clicked => { root.open-logs(); }
                            Rectangle {
                                border-radius: 4px;
                                background: touch-main-log.has-hover ? (root.is-dark-theme ? #5558a0 : #4d51ab) : transparent;
                                Text {
                                    text: "📄";
                                    font-size: 14px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }

                // Search or Filter bar
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    padding-top: 6px;
                    padding-bottom: 6px;

                    search-input := LineEdit {
                        placeholder-text: "Search chats...";
                    }
                }

                // Chat list
                ScrollView {
                    VerticalLayout {
                        padding: 6px;
                        spacing: 2px;
                        alignment: start;

                        for conv in root.conversations: ChatItem {
                            title: conv.title;
                            last-message: conv.last-message;
                            timestamp: conv.timestamp;
                            unread-count: conv.unread-count;
                            avatar-text: conv.avatar-text;
                            is-selected: conv.id == root.active-conversation-id;
                            is-dark-theme: root.is-dark-theme;
                            clicked => {
                                root.select-conversation(conv.id);
                            }
                        }

                        if !root.is-connected: VerticalLayout {
                            padding: 16px;
                            spacing: 12px;
                            alignment: center;

                            Text {
                                text: root.connection-status;
                                color: root.is-dark-theme ? #ff8888 : #cc2222;
                                font-size: 11px;
                                wrap: word-wrap;
                                horizontal-alignment: center;
                            }

                            HorizontalLayout {
                                alignment: center;
                                spacing: 8px;
                                Button {
                                    text: "Thử lại (Retry)";
                                    clicked => { root.trigger-refresh(); }
                                }
                                Button {
                                    text: "📄 Xem Log";
                                    clicked => { root.open-logs(); }
                                }
                            }
                        }
                    }
                }
            }
        }

        // Right Pane: Active Conversation & Messages
        Rectangle {
            background: root.is-dark-theme ? #1f1f1f : #ffffff;
            horizontal-stretch: 1;

            VerticalLayout {
                // Update banner
                if root.is-update-available: Rectangle {
                    height: 42px;
                    background: root.is-dark-theme ? #382d00 : #fffbe6;
                    border-width: 1px;
                    border-color: root.is-dark-theme ? #665000 : #ffe58f;

                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        spacing: 10px;
                        alignment: center;

                        Text {
                            text: root.update-info-text;
                            color: root.is-dark-theme ? #ffd666 : #ad6800;
                            font-size: 12px;
                            font-weight: 600;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }

                        Button {
                            text: "⚡ Cập nhật ngay";
                            primary: true;
                            clicked => { root.install-update(); }
                        }

                        Button {
                            text: "Chi tiết";
                            clicked => { root.open-update-url(); }
                        }
                    }
                }

                // Chat header
                Rectangle {
                    height: 56px;
                    border-width: 1px;
                    border-color: root.is-dark-theme ? #333338 : #ededf2;
                    background: root.is-dark-theme ? #252529 : #fafafc;

                    HorizontalLayout {
                        padding-left: 20px;
                        padding-right: 20px;
                        alignment: center;

                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;
                            horizontal-stretch: 1;

                            Text {
                                text: root.active-conversation-title;
                                font-size: 15px;
                                font-weight: 700;
                                color: root.is-dark-theme ? #ffffff : #242424;
                            }

                            if root.active-conversation-id != "": Text {
                                text: "Microsoft Teams Chat (Real-time Push)";
                                font-size: 11px;
                                color: root.is-dark-theme ? #9e9e9e : #707070;
                            }
                        }
                    }
                }

                // Messages View
                if root.active-conversation-id == "": Rectangle {
                    vertical-stretch: 1;
                    Text {
                        text: "Select a conversation to start chatting";
                        color: root.is-dark-theme ? #737373 : #8c8c8c;
                        font-size: 14px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                if root.active-conversation-id != "": ScrollView {
                    vertical-stretch: 1;

                    VerticalLayout {
                        padding: 16px;
                        spacing: 8px;
                        alignment: start;

                        for msg in root.messages: MessageBubble {
                            sender-name: msg.sender-name;
                            content: msg.content;
                            timestamp: msg.timestamp;
                            is-self: msg.is-self;
                            is-dark-theme: root.is-dark-theme;
                        }
                    }
                }

                // Message composer
                if root.active-conversation-id != "": Rectangle {
                    height: 64px;
                    border-width: 1px;
                    border-color: root.is-dark-theme ? #333338 : #e5e5ea;
                    background: root.is-dark-theme ? #252529 : #ffffff;

                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        padding-top: 10px;
                        padding-bottom: 10px;
                        spacing: 12px;
                        alignment: center;

                        input-msg := LineEdit {
                            horizontal-stretch: 1;
                            placeholder-text: "Type a message... (Press Enter or click Send)";
                            text <=> root.draft-text;
                            accepted => {
                                if (root.draft-text != "") {
                                    root.send-message(root.draft-text);
                                    root.draft-text = "";
                                }
                            }
                        }

                        Button {
                            text: "Send";
                            primary: true;
                            enabled: root.draft-text != "";
                            clicked => {
                                if (root.draft-text != "") {
                                    root.send-message(root.draft-text);
                                    root.draft-text = "";
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
